  "narrative_state": {
    "red-figure-responsive-plea": {
      "id": "red-figure-responsive-plea",
      "kind": "fact",
      "text": "模型中的紅衣人排出求救瓦字，並隨余棠及陸衡移動的燈光改變動作。",
      "source": {
        "chapter": 1,
        "start_line": 25,
        "end_line": 49,
        "sha256": "963f7c008982026f02dd7aaf39342e8d060bde2e82bb7094f75ae2123f2b7d82"
      },
      "status": "active",
      "introduced_in": 1,
      "updated_in": 1
    },
    "yutang-response-observation": {
      "id": "yutang-response-observation",
      "kind": "knowledge",
      "character": "余棠",
      "text": "余棠親眼確認紅衣人會回應自己的燈光與動作。",
      "source": {
        "chapter": 1,
        "start_line": 35,
        "end_line": 63,
        "sha256": "963f7c008982026f02dd7aaf39342e8d060bde2e82bb7094f75ae2123f2b7d82"
      },
      "status": "active",
      "introduced_in": 1,
      "updated_in": 1
    },
    "luheng-response-observation": {
      "id": "luheng-response-observation",
      "kind": "knowledge",
      "character": "陸衡",
      "text": "陸衡親自移動光帶，看見紅衣人轉向搬瓦；他確認有人回應，但仍要求下一步處置。",
      "source": {
        "chapter": 1,
        "start_line": 43,
        "end_line": 61,
        "sha256": "963f7c008982026f02dd7aaf39342e8d060bde2e82bb7094f75ae2123f2b7d82"
      },
      "status": "active",
      "introduced_in": 1,
      "updated_in": 1
    },
    "yutang-flood-plan-briefing": {
      "id": "yutang-flood-plan-briefing",
      "kind": "knowledge",
      "character": "余棠",
      "text": "余棠聽陸衡說人工開閘最早09:14、至少比原定09:10晚四分鐘，工班尚未到場，時間仍不確定；原閘仍需開，舊渠只能分擔部分水量與爭取撤離時間。",
      "source": {
        "chapter": 2,
        "start_line": 25,
        "end_line": 35,
        "sha256": "2785311824c7e9665eb177cc8c8a4dd20a88f1a53ae582d41ddb68a4037e7841"
      },
      "status": "active",
      "introduced_in": 1,
      "updated_in": 2
    },
    "old-hole-and-tally-observed": {
      "id": "old-hole-and-tally-observed",
      "kind": "fact",
      "text": "底板後已露出兩條石槽，一條止於鏽斑，另一條向北延伸到船塢棚屋牆底；可見槽口狹窄。",
      "source": {
        "chapter": 2,
        "start_line": 19,
        "end_line": 39,
        "sha256": "2785311824c7e9665eb177cc8c8a4dd20a88f1a53ae582d41ddb68a4037e7841"
      },
      "status": "active",
      "introduced_in": 1,
      "updated_in": 2
    },
    "yutang-board-removal-cost": {
      "id": "yutang-board-removal-cost",
      "kind": "knowledge",
      "character": "余棠",
      "text": "余棠知道取下底板會散去潮痕、使兩鎖失準；即使期限前裝回，也須等下次退潮，舊方案不能落印。",
      "source": {
        "chapter": 1,
        "start_line": 109,
        "end_line": 119,
        "sha256": "963f7c008982026f02dd7aaf39342e8d060bde2e82bb7094f75ae2123f2b7d82"
      },
      "status": "active",
      "introduced_in": 1,
      "updated_in": 1
    },
    "first-board-intervention-state": {
      "id": "first-board-intervention-state",
      "kind": "fact",
      "text": "余棠已完整取下維修底板，潮痕散去；陸衡插入工程鑰匙後無法轉到底。底板被置於修件架，裝回不能恢復潮痕。",
      "source": {
        "chapter": 2,
        "start_line": 9,
        "end_line": 19,
        "sha256": "2785311824c7e9665eb177cc8c8a4dd20a88f1a53ae582d41ddb68a4037e7841"
      },
      "status": "active",
      "introduced_in": 1,
      "updated_in": 2
    },
    "yutang-real-channel-report": {
      "id": "yutang-real-channel-report",
      "kind": "knowledge",
      "character": "余棠",
      "text": "余棠經陸衡得知工班發現倉庫牆內舊拱口、牆腳滲水，外側出水溝淤泥多；現場擬先拆小口察看，木料與機件不能及時全搬走。這是電話查勘回報，不是她親到現場所見。",
      "source": {
        "chapter": 2,
        "start_line": 51,
        "end_line": 65,
        "sha256": "2785311824c7e9665eb177cc8c8a4dd20a88f1a53ae582d41ddb68a4037e7841"
      },
      "status": "active",
      "introduced_in": 2,
      "updated_in": 2
    },
    "projected-writing-exchange": {
      "id": "projected-writing-exchange",
      "kind": "fact",
      "text": "余棠在罩外透明修件片上寫字，以工作燈把字影投到模型白牆；紅衣人在模型濕泥上劃字，余棠用放大鏡辨讀。兩邊仍無可直接交談的聲音。",
      "source": {
        "chapter": 2,
        "start_line": 75,
        "end_line": 89,
        "sha256": "2785311824c7e9665eb177cc8c8a4dd20a88f1a53ae582d41ddb68a4037e7841"
      },
      "status": "active",
      "introduced_in": 2,
      "updated_in": 2
    },
    "model-rescue-before-demolition": {
      "id": "model-rescue-before-demolition",
      "kind": "fact",
      "text": "紅衣人寫下『先接人』並壓住破牆長桿；余棠以『先橋，後牆』回覆。居民先搬走工具，再拆下棚門作為橋板，未同意先拆棚牆。",
      "source": {
        "chapter": 2,
        "start_line": 81,
        "end_line": 109,
        "sha256": "2785311824c7e9665eb177cc8c8a4dd20a88f1a53ae582d41ddb68a4037e7841"
      },
      "status": "active",
      "introduced_in": 2,
      "updated_in": 2
    },
    "yutang-hospital-power-report": {
      "id": "yutang-hospital-power-report",
      "kind": "knowledge",
      "character": "余棠",
      "text": "陸衡轉述醫院已為搬運安全斷掉地下層電源，上層暫時仍有電，電工正在搬設備；又說現實倉庫開始鑿牆，機件只搬出一半。",
      "source": {
        "chapter": 2,
        "start_line": 111,
        "end_line": 119,
        "sha256": "2785311824c7e9665eb177cc8c8a4dd20a88f1a53ae582d41ddb68a4037e7841"
      },
      "status": "active",
      "introduced_in": 2,
      "updated_in": 2
    },
    "flood-response-state": {
      "id": "flood-response-state",
      "kind": "fact",
      "text": "09:09時現實分流閘尚未開，模型棚牆完整；居民正在將門板送往斷橋，余棠留下『先橋，後牆』字影。尚未完成救人或驗證舊渠排洪效果。",
      "source": {
        "chapter": 2,
        "start_line": 125,
        "end_line": 131,
        "sha256": "2785311824c7e9665eb177cc8c8a4dd20a88f1a53ae582d41ddb68a4037e7841"
      },
      "status": "active",
      "introduced_in": 2,
      "updated_in": 2
    }
  },
